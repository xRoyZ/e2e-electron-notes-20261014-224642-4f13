{
  "name": "notes-app",
  "private": true,
  "version": "1.0.0",
  "description": "Local-first desktop notes app with markdown preview, search and pinning",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.notes.app",
    "productName": "Notes",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**"
    ]
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "global-agent": "4.1.3"
  }
}
